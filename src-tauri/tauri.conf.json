{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaizen Study",
  "version": "0.2.0",
  "identifier": "com.kaizenstudy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kaizen Study",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "transparent": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https:; font-src 'self' data:; media-src 'self' data: blob: asset: http://asset.localhost; frame-src asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "shortDescription": "Organizador de sesiones de estudio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "es-ES"
      },
      "nsis": {
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0NDc2NEU5RDdBNDExQ0YKUldUUEVhVFg2V1JIQkp0WGVpNlg0NzRGd1ZuVmdtZEtCRmlEb216WjNNVjB0b25yUWhoaWdxclMK",
      "endpoints": [
        "https://github.com/AndrewQuest/kaizen-study/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}